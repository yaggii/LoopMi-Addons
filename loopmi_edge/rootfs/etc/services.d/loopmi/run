#!/command/with-contenv bash
set -euo pipefail

LOOPMI_APP_DIR="/app"
LOOPMI_BINARY="${LOOPMI_APP_DIR}/LoopMi.Edge"
CONFIG_DIR="/config/loopmi"
CONFIG_FILE="${CONFIG_DIR}/appsettings.json"
APPSETTINGS_FILE="${LOOPMI_APP_DIR}/appsettings.json"

mkdir -p /data "${CONFIG_DIR}"

if [ ! -f "${LOOPMI_BINARY}" ]; then
    echo "LoopMi binary not found at ${LOOPMI_BINARY}. Stage published artifacts before building the add-on image."
    exit 1
fi

if [ ! -f "${CONFIG_FILE}" ] && [ -f "${APPSETTINGS_FILE}" ]; then
    cp "${APPSETTINGS_FILE}" "${CONFIG_FILE}"
fi

if [ -f "${CONFIG_FILE}" ]; then
    ln -sf "${CONFIG_FILE}" "${APPSETTINGS_FILE}"
fi

export ASPNETCORE_URLS="http://0.0.0.0:5034"
export Measurements__DatabasePath="/data/loopmi-edge.db"

# The client identity certificate/CA pin are written during registration and must survive addon
# restarts/updates - /data is the persistent volume HA maps in, unlike the app's own working directory.
export Provisioning__ClientIdentityPfxPath="/data/edge-identity.pfx"
export Provisioning__CaCertificatePemPath="/data/loopmi-ca.pem"

if [ -n "${SUPERVISOR_TOKEN:-}" ]; then
    export HomeAssistant__BaseUrl="http://supervisor"
    export HomeAssistant__WebSocketPath="/core/websocket"
    export HomeAssistant__LongLivedAccessToken="${SUPERVISOR_TOKEN}"
fi

# Threads the "registration_token"/"cloud_base_url"/"ingestion_base_url" add-on options (config.yaml)
# through to the app - /data/options.json is where the Supervisor writes configured option values for
# every add-on. cloud_base_url is registration only (RegisterEdgeGatewayFunction, in the Provisioning
# Function App) - ingestion_base_url is the separate host the ongoing check-in/discovery/measurement
# calls need (those routes live in the Ingestion Function App instead). Previously only cloud_base_url
# existed and both clients read it, so registration worked but every call after it 404'd.
OPTIONS_FILE="/data/options.json"

if [ -f "${OPTIONS_FILE}" ]; then
    REGISTRATION_TOKEN="$(jq -r '.registration_token // empty' "${OPTIONS_FILE}")"
    CLOUD_BASE_URL="$(jq -r '.cloud_base_url // empty' "${OPTIONS_FILE}")"
    INGESTION_BASE_URL="$(jq -r '.ingestion_base_url // empty' "${OPTIONS_FILE}")"

    if [ -n "${REGISTRATION_TOKEN}" ]; then
        export Provisioning__RegistrationToken="${REGISTRATION_TOKEN}"
    fi

    if [ -n "${CLOUD_BASE_URL}" ]; then
        export Provisioning__CloudBaseUrl="${CLOUD_BASE_URL}"
    fi

    if [ -n "${INGESTION_BASE_URL}" ]; then
        export Ingestion__CloudBaseUrl="${INGESTION_BASE_URL}"
    fi
fi

exec /app/LoopMi.Edge
